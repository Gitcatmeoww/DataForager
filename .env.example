# ── OpenAI / Azure OpenAI ────────────────────────────────────────────────
# DataForager uses Azure OpenAI by default (see
# src/dataforager/table_representation/openai_client.py).
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
AZURE_OPENAI_ENDPOINT=YOUR_AZURE_OPENAI_ENDPOINT
# Only needed if you switch the client to standard OpenAI instead of Azure.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# ── PostgreSQL (with the pgvector extension) ─────────────────────────────
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_HOST=localhost
DB_PORT=5432
# Database the API searches over (the main corpus).
EVAL_DB_NAME=dataforager_corpus
# Optional: separate database for the small data.gov demo corpus.
MOCK_DB_NAME=dataforager_demo

# ── Elasticsearch (only for the keyword-search evaluation baseline) ──────
# ES_MODE selects the backend: "local" (default) or "cloud" (Azure).
ES_MODE=local
AZURE_ES_API_KEY=YOUR_AZURE_ELASTICSEARCH_API_KEY
AZURE_ES_ENDPOINT=YOUR_AZURE_ELASTICSEARCH_ENDPOINT

# ── Flask ────────────────────────────────────────────────────────────────
# Set to 0 to disable Flask debug mode when running `dataforager-api`.
FLASK_DEBUG=1
